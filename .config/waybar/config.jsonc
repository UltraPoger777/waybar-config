{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,

  "modules-left": [
    "custom/weather",
    "mpris"
  ],
  "modules-center": [
    "hyprland/workspaces",
    "clock#main",
    "custom/todo"
  ],
  "modules-right": [
    "battery",
    "custom/brightness",
    "custom/volume",
    "tray"
  ],

  "custom/weather": {
    "exec": "$HOME/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "interval": 900,
    "format": "{}",
    "tooltip": true,
    "on-click": "xdg-open \"https://wttr.in\""
  },

  "clock#main": {
    "locale": "en_US.UTF-8",
    "format": "  {:%H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#f5c2e7'><b>{}</b></span>",
        "days": "<span color='#89b4fa'><b>{}</b></span>",
        "weeks": "<span color='#a6e3a1'><b>W{}</b></span>",
        "weekdays": "<span color='#fab387'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b>{}</b></span>"
      }
    }
  },
  "custom/todo": {
    "exec": "$HOME/.config/waybar/scripts/todo.sh",
    "return-type": "json",
    "interval": 20,
    "format": "{}",
    "tooltip": true,
    "on-click": "xdg-open \"$HOME/.config/waybar/todo.txt\""
  },
  "hyprland/workspaces": {
    "active-only": false,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "empty": ""
    }
  },
  "battery": {
    "interval": 10,
    "states": {
      "warning": 25,
      "critical": 12
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "Battery: {capacity}% ({timeTo})"
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "dynamic-order": [
      "title",
      "artist"
    ],
    "dynamic-len": 38,
    "max-length": 50,
    "status-icons": {
      "paused": "",
      "playing": "",
      "stopped": ""
    },
    "player-icons": {
      "default": "",
      "spotify": ""
    },
    "ignored-players": [
      "firefox"
    ],
    "tooltip-format": "{player} — {title}\n{artist}"
  },

  "custom/volume": {
    "exec": "$HOME/.config/waybar/scripts/volume.sh",
    "return-type": "json",
    "interval": 1,
    "format": "{}",
    "tooltip": true,
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "custom/brightness": {
    "exec": "$HOME/.config/waybar/scripts/brightness.sh",
    "return-type": "json",
    "interval": 1,
    "format": "{}",
    "tooltip": true,
    "on-scroll-up": "brightnessctl -q set +5%",
    "on-scroll-down": "brightnessctl -q set 5%-"
  },

  "tray": {
    "spacing": 8
  }
}
