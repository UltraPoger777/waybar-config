{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,

  "modules-left": [
    "custom/weather",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "group/time_center"
  ],
  "modules-right": [
    "group/quick_settings",
    "custom/media",
    "battery",
    "custom/brightness",
    "custom/volume",
    "tray"
  ],

  "custom/weather": {
    "exec": "$HOME/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "interval": 900,
    "format": "{}",
    "tooltip": true,
    "on-click": "xdg-open \"https://wttr.in\""
  },

  "group/time_center": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 240,
      "children-class": "time-center-child",
      "transition-left-to-right": true
    },
    "modules": [
      "clock#main",
      "custom/todo-inline"
    ],
    "tooltip": false
  },
  "clock#main": {
    "locale": "en_US.UTF-8",
    "format": "  {:%H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#f5c2e7'><b>{}</b></span>",
        "days": "<span color='#89b4fa'><b>{}</b></span>",
        "weeks": "<span color='#a6e3a1'><b>W{}</b></span>",
        "weekdays": "<span color='#fab387'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b>{}</b></span>"
      }
    }
  },
  "custom/todo-inline": {
    "exec": "$HOME/.config/waybar/scripts/todo_inline.sh",
    "return-type": "json",
    "interval": 20,
    "format": "{}",
    "tooltip": true,
    "on-click": "sh -c 'mkdir -p \"$HOME/.config/waybar\"; touch \"$HOME/.config/waybar/todo.txt\"; xdg-open \"$HOME/.config/waybar/todo.txt\"'",
    "on-click-right": "sh -c 'mkdir -p \"$HOME/.config/waybar\"; touch \"$HOME/.config/waybar/todo.txt\"; xdg-open \"$HOME/.config/waybar/todo.txt\"'"
  },
  "group/quick_settings": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 240,
      "children-class": "quick-settings-child",
      "transition-left-to-right": true
    },
    "modules": [
      "custom/quick-settings-icon",
      "custom/wifi",
      "custom/bluetooth",
      "custom/hotspot"
    ],
    "tooltip": false
  },
  "custom/quick-settings-icon": {
    "format": "󰒓",
    "tooltip": false
  },
  "custom/wifi": {
    "exec": "$HOME/.config/waybar/scripts/wifi_status.sh",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "tooltip": true,
    "on-click": "$HOME/.config/waybar/scripts/wifi_toggle.sh"
  },
  "custom/bluetooth": {
    "exec": "$HOME/.config/waybar/scripts/bluetooth_status.sh",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "tooltip": true,
    "on-click": "$HOME/.config/waybar/scripts/bluetooth_toggle.sh"
  },
  "custom/hotspot": {
    "exec": "$HOME/.config/waybar/scripts/hotspot_status.sh",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "tooltip": true,
    "on-click": "$HOME/.config/waybar/scripts/hotspot_toggle.sh"
  },
  "custom/media": {
    "exec": "$HOME/.config/waybar/scripts/media.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "tooltip": true,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next"
  },
  "hyprland/workspaces": {
    "active-only": false,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "empty": ""
    }
  },
  "battery": {
    "interval": 10,
    "states": {
      "warning": 25,
      "critical": 12
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "Battery: {capacity}% ({timeTo})"
  },

  "custom/volume": {
    "exec": "$HOME/.config/waybar/scripts/volume.sh",
    "return-type": "json",
    "interval": 1,
    "format": "{}",
    "tooltip": true,
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "custom/brightness": {
    "exec": "$HOME/.config/waybar/scripts/brightness.sh",
    "return-type": "json",
    "interval": 1,
    "format": "{}",
    "tooltip": true,
    "on-scroll-up": "brightnessctl -q set +5%",
    "on-scroll-down": "brightnessctl -q set 5%-"
  },

  "tray": {
    "spacing": 8
  }
}
